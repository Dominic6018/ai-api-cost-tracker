# Copy to .env.local (Next.js) and .env (drizzle-kit), then adjust.
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgres://cost_tracker:cost_tracker@localhost:5432/cost_tracker

# Set to true when DATABASE_URL points at a transaction-mode pooler
# (PgBouncer, or a hosted provider's pooled endpoint). See docs/DEPLOYMENT.md.
# DATABASE_POOLED=false
