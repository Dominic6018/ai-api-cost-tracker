# Copy to .env.local (Next.js) and .env (drizzle-kit), then adjust.
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgres://cost_tracker:cost_tracker@localhost:5432/cost_tracker

# Set to true when DATABASE_URL points at a transaction-mode pooler
# (PgBouncer, or a hosted provider's pooled endpoint). See docs/DEPLOYMENT.md.
# DATABASE_POOLED=false

# Budget notifications from `npm run budget-alerts` (see README). Set either
# any destinations; the secret signs the webhook's requests. Email needs all
# three of its settings.
# BUDGET_ALERT_WEBHOOK_URL=https://hooks.example.com/budget
# BUDGET_ALERT_WEBHOOK_SECRET=
# BUDGET_ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# BUDGET_ALERT_SMTP_URL=smtps://alerts:password@mail.example.com:465
# BUDGET_ALERT_EMAIL_FROM=alerts@example.com
# BUDGET_ALERT_EMAIL_TO=you@example.com,finance@example.com

# Optional single sign-on with OpenID Connect (see README). Register
# OIDC_REDIRECT_URI with your provider; existing accounts sign in by verified
# email. Leave unset for password sign-in only.
# OIDC_ISSUER=https://example.okta.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://costs.example.com/login/oidc/callback
# OIDC_NAME=Okta
